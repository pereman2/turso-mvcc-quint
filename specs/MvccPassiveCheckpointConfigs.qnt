// Expect ReadsCorrect to fail: GC uses a stale lwm of no reader and Rule 3
// drops a row that an open reader needs.
// Invariants: ReadsCorrect
module gcSampleNoRecheck {
  import MvccPassiveCheckpoint(
    Keys = Set("k1"),
    Readers = Set("r1", "r2"),
    MaxTs = 5,
