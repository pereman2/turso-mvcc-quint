+/// Test-only hooks that run another connection's code inside a window that
+/// has no yield point, to reproduce races between threads.
+#[cfg(test)]
+pub(crate) mod race_hooks {
+    use std::cell::RefCell;
+
+    #[derive(Clone, Copy, PartialEq, Eq, Debug)]
+    pub(crate) enum RaceHook {
+        /// After the leader checks that a batch record's tx is in `txs`,
+        /// before `log_tx`.
+        BeforeLogTx,
+        /// In `cleanup_dropped_commit`, after the state read, before
+        /// `abandon_if_issued`.
+        BeforeAbandonIfIssued,
+    }
+
+    type Hook = (RaceHook, Box<dyn FnOnce()>);
+
+    thread_local! {
+        static HOOK: RefCell<Option<Hook>> = const { RefCell::new(None) };
+    }
+
+    pub(crate) fn set(at: RaceHook, f: impl FnOnce() + 'static) {
+        HOOK.with(|h| *h.borrow_mut() = Some((at, Box::new(f))));
+    }
+
+    pub(crate) fn pending() -> bool {
+        HOOK.with(|h| h.borrow().is_some())
+    }
+
+    pub(crate) fn fire(at: RaceHook) {
+        let f = HOOK.with(|h| {
+            let mut h = h.borrow_mut();
+            match h.take() {
+                Some((p, f)) if p == at => Some(f),
+                other => {
+                    *h = other;
+                    None
+                }
+            }
+        });
+        if let Some(f) = f {
+            f();
+        }
+    }
+}
